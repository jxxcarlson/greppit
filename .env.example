# greppit — example environment configuration
#
# Copy this to `.env` at the project root and edit for your machine.
# Scripts under `scripts/` auto-load `.env` at the project root.
#
# Local dev: defaults are fine; you can probably skip the .env entirely.
# Shared server (e.g. a droplet also running scripta or anything else on 8085):
# set different ports here so kill/stop/restart touch only greppit.


# --- Database ---

# Local Postgres, libpq URL form (works everywhere)
DATABASE_URL=postgres://localhost/greppit_dev?sslmode=disable

# Production example (set on your droplet, not locally):
# DATABASE_URL=postgres://greppit_user:PASSWORD@localhost/greppit_prod


# --- Ports ---

# Default 8085 (backend) and 8011 (frontend). On a server already running
# another Haskell/Servant backend on 8085, pick different ports here so
# greppit's scripts (kill.sh, stop.sh, restart.sh) don't touch the neighbour.
#
# Example server overrides:
# GREPPIT_BACKEND_PORT=8086
# GREPPIT_FRONTEND_PORT=8012


# --- JWT ---

# Must be >= 32 bytes in production (HS256 requirement).
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# JWT_EXPIRY_DAYS=7


# --- db-fetch-dump.sh (pull dumps from the production host) ---

# GREPPIT_PROD_HOST=root@your-server
# GREPPIT_PROD_BACKUP_DIR=/root/greppit/backups
