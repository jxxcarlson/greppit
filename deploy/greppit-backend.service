[Unit]
Description=greppit backend
After=network.target postgresql.service
Wants=postgresql.service

# Fail fast if it crashes repeatedly — gives you a clean error state
# instead of a runaway restart spiral while you debug.
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple

# Unprivileged system user (useradd --system --no-create-home --shell
# /usr/sbin/nologin greppit). systemd reads EnvironmentFile as root before
# dropping to it, so .env stays root-only (600). The backend writes no
# files, so the sandbox below allows no writes at all. Set up on rose2 by
# deploy/run-backends-unprivileged.sh (2026-11-01).
User=greppit
Group=greppit
WorkingDirectory=/root/greppit/backend

# DATABASE_URL, JWT_SECRET, JWT_EXPIRY_DAYS, GREPPIT_BACKEND_PORT, etc.
# live in /root/greppit/.env — see deploy/README.md.
EnvironmentFile=/root/greppit/.env

# Call the compiled binary directly. `stack exec` computes a snapshot
# hash that can differ between interactive shells and systemd's context,
# causing "Executable named greppit-backend not found on path" failures
# under systemd even when the binary exists. Install once with:
#
#     cd /root/greppit/backend && stack install --local-bin-path /usr/local/bin
#
# and then this unit just runs the resulting binary.
ExecStart=/usr/local/bin/greppit-backend

Restart=on-failure
RestartSec=3

# Lock down the service a little.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
